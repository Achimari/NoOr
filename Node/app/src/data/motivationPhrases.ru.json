[
  {
    "id": "1-cor-10-13",
    "text": "Верен Бог.\nОн даст и облегчение.",
    "source": "1 Коринфянам 10:13"
  },
  {
    "id": "phil-4-13",
    "text": "Всё могу\nво Христе.",
    "source": "Филиппийцам 4:13"
  },
  {
    "id": "gal-6-9",
    "text": "Не унывайте.\nПридёт время жатвы.",
    "source": "Галатам 6:9"
  },
  {
    "id": "josh-1-9",
    "text": "Будь твёрд.\nБудь мужествен.",
    "source": "Иисус Навин 1:9"
  },
  {
    "id": "prov-4-23",
    "text": "Храни сердце.\nИз него источники жизни.",
    "source": "Притчи 4:23"
  },
  {
    "id": "psalm-119-11",
    "text": "Сокрой Слово в сердце.\nСтой твёрдо.",
    "source": "Псалтирь 118:11"
  },
  {
    "id": "rom-12-21",
    "text": "Побеждай зло\nдобром.",
    "source": "Римлянам 12:21"
  },
  {
    "id": "2-tim-1-7",
    "text": "Сила.\nЛюбовь. Целомудрие.",
    "source": "2 Тимофею 1:7"
  },
  {
    "id": "heb-12-1",
    "text": "Свергни грех.\nПроходи поприще.",
    "source": "Евреям 12:1"
  },
  {
    "id": "matt-26-41",
    "text": "Бодрствуйте и молитесь.\nСтойте твёрдо.",
    "source": "От Матфея 26:41"
  },
  {
    "id": "psalm-46-1",
    "text": "Бог — прибежище\nи сила.",
    "source": "Псалтирь 45:2"
  },
  {
    "id": "isaiah-40-31",
    "text": "Надейтесь на Господа.\nОбновится сила.",
    "source": "Исаия 40:31"
  },
  {
    "id": "eph-6-11",
    "text": "Облекитесь во всеоружие.\nСтойте твёрдо.",
    "source": "Ефесянам 6:11"
  },
  {
    "id": "james-4-7",
    "text": "Противостаньте диаволу.\nИ убежит от вас.",
    "source": "Иакова 4:7"
  },
  {
    "id": "psalm-37-5",
    "text": "Предай путь Господу.\nУповай на Него.",
    "source": "Псалтирь 36:5"
  },
  {
    "id": "1-peter-5-7",
    "text": "Возложите заботы на Него.\nОн печётся о вас.",
    "source": "1 Петра 5:7"
  },
  {
    "id": "rom-8-37",
    "text": "Более чем побеждаем\nсилою Христа.",
    "source": "Римлянам 8:37"
  },
  {
    "id": "john-8-36",
    "text": "Сын освобождает.\nЖивите свободными.",
    "source": "От Иоанна 8:36"
  },
  {
    "id": "psalm-34-8",
    "text": "Вкусите и увидите,\nкак благ Господь.",
    "source": "Псалтирь 33:9"
  },
  {
    "id": "lam-3-23",
    "text": "Милость Его обновляется\nкаждое утро.",
    "source": "Плач Иеремии 3:23"
  }
]
