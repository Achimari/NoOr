
<%
  const missed = typeof missedActivities === "undefined" || !missedActivities
    ? { total: 0, items: [] }
    : missedActivities;
  const CATCH_UP_PAGE_SIZE = 5;
  const catchUpCopy = {
    STRONG: { name: t("Strong check-in"), note: t("Say whether you stayed strong that day."), action: t("Answer") },
    READING: { name: t("Bible reading"), note: t("Record what you read, or say you did not read."), action: t("Answer") },
    GOALS: { name: t("Daily tasks"), note: t("Add the tasks you completed, or say you completed none."), action: t("Answer") },
  };
  const catchUpLocale = typeof dateLocale === "undefined" || !dateLocale ? "en" : dateLocale;
  const catchUpDate = (dateKey) => {
    const date = new Date(`${dateKey}T12:00:00.000Z`);
    if (Number.isNaN(date.getTime())) return String(dateKey || "");
    return new Intl.DateTimeFormat(catchUpLocale, {
      weekday: "short", month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
    }).format(date);
  };
  const firstPage = (missed.items || [])
    .filter((item) => catchUpCopy[item.activity])
    .slice(0, CATCH_UP_PAGE_SIZE);
  const hasMore = missed.total > firstPage.length;

  /*
    On a phone the correction backlog sits between the day's title and the first
    practice, so a long list pushes the day's own work off the screen. The list
    lives in a native <details> that the server always renders open: with no
    JavaScript, and on every window wider than a phone, the list is simply
    visible exactly as it always was. `app.js` closes it on a phone when the
    backlog is long enough to be worth folding, and the summary — hidden above
    the phone range by `pages/daily-check-in.css` — is how it reopens.

    Rendering open rather than closed is deliberate: a closed disclosure that
    only a script can open would put the correction flow behind JavaScript.
  */
  const CATCH_UP_SHORT_LIST = 2;
  const collapsible = missed.total > CATCH_UP_SHORT_LIST;
%>
<section class="dashboard-card catch-up-card" data-catch-up<%= missed.total ? "" : " hidden" %> tabindex="-1" aria-labelledby="catch-up-title">
  <header class="dashboard-card-head catch-up-head">
    <div class="catch-up-heading">
      <p class="dashboard-label"><%= t("Catch up") %></p>
      <h2 id="catch-up-title"><%= t("You have unfinished days") %></h2>
    </div>
    <span class="catch-up-count" data-catch-up-count><%= missed.total ? t("{count} left", { count: missed.total }) : "" %></span>
  </header>

  <p class="catch-up-hint"><%= t("Complete the activities you missed to keep your history accurate.") %></p>

  <details class="catch-up-disclosure" data-catch-up-disclosure<%- collapsible ? " data-phone-fold" : "" %> open>
    <summary class="fold-summary" data-catch-up-summary aria-controls="catch-up-list">
      <span class="fold-summary-label"><%= t("Days to correct") %></span>
      <span class="fold-summary-count" data-catch-up-summary-count><%= missed.total || 0 %></span>
    </summary>

    <div class="catch-up-body fold-body" data-catch-up-body>
      <ul class="catch-up-list" id="catch-up-list" data-catch-up-list aria-labelledby="catch-up-title">
        <% firstPage.forEach((item) => { %>
          <% const copy = catchUpCopy[item.activity]; %>
          <% const label = catchUpDate(item.dateKey); %>
          <li class="catch-up-item" data-catch-up-item data-catch-up-date="<%= item.dateKey %>" data-catch-up-activity="<%= item.activity %>">
            <div class="catch-up-item-copy">
              <p class="catch-up-item-date" data-catch-up-date><%= label %></p>
              <p class="catch-up-item-activity" data-catch-up-activity><%= copy.name %></p>
              <p class="catch-up-item-note" data-catch-up-note><%= copy.note %></p>
            </div>
            <button
              class="catch-up-action"
              type="button"
              data-catch-up-open
              data-catch-up-date="<%= item.dateKey %>"
              data-catch-up-activity="<%= item.activity %>"
              aria-haspopup="dialog"
              aria-label="<%= t("{action} {name} for {date}", { action: copy.action, name: copy.name, date: label }) %>"
            ><%= copy.action %></button>
          </li>
        <% }) %>
      </ul>

      <button
        class="catch-up-more"
        type="button"
        data-catch-up-more
        aria-controls="catch-up-list"
        aria-expanded="false"
        <%= hasMore ? "" : "hidden" %>
      ><%= t("View more") %></button>
    </div>
  </details>

  <p class="catch-up-status sr-only" data-catch-up-status role="status" aria-live="polite"></p>
  <p class="sr-only" data-catch-up-page-status role="status" aria-live="polite"></p>
</section>

<template data-catch-up-template>
  <li class="catch-up-item" data-catch-up-item>
    <div class="catch-up-item-copy">
      <p class="catch-up-item-date" data-catch-up-date></p>
      <p class="catch-up-item-activity" data-catch-up-activity></p>
      <p class="catch-up-item-note" data-catch-up-note></p>
    </div>
    <button class="catch-up-action" type="button" data-catch-up-open></button>
  </li>
</template>

<div class="missed-answer-modal catch-up-answer-modal" data-catch-up-answer-modal hidden>
  <div class="missed-answer-backdrop" data-catch-up-answer-close></div>
  <div class="missed-answer-dialog" role="dialog" aria-modal="true" aria-labelledby="catch-up-answer-title">
    <header class="missed-answer-head">
      <p class="dashboard-label" data-catch-up-answer-date><%= t("Missed day") %></p>
      <h2 id="catch-up-answer-title" data-catch-up-answer-title><%= t("Answer a missed day") %></h2>
      <p class="catch-up-answer-note" data-catch-up-answer-note></p>
    </header>
    <div class="missed-answer-actions">
      <button class="catch-up-answer-option catch-up-answer-option-yes" type="button" data-catch-up-answer="YES" data-catch-up-answer-yes><%= t("Yes") %></button>
      <button class="catch-up-answer-option catch-up-answer-option-no" type="button" data-catch-up-answer="NO" data-catch-up-answer-no><%= t("No") %></button>
    </div>
    <div class="catch-up-answer-footer">

      <button class="ui-button ui-button--quiet" type="button" data-catch-up-answer-close><%= t("Cancel") %></button>
    </div>
  </div>
</div>

<div class="catch-up-tasks-modal" data-catch-up-tasks-modal hidden>
  <div class="catch-up-tasks-backdrop" data-catch-up-tasks-close></div>
  <div class="catch-up-tasks-dialog" role="dialog" aria-modal="true" aria-labelledby="catch-up-tasks-title">
    <form class="catch-up-tasks-form" data-catch-up-tasks-form novalidate>
      <header class="catch-up-tasks-head">
        <div>
          <p class="dashboard-label" data-catch-up-tasks-date><%= t("Missed day") %></p>
          <h2 id="catch-up-tasks-title"><%= t("What did you complete?") %></h2>
        </div>
      </header>

      <div class="catch-up-tasks-body">
        <p class="catch-up-tasks-hint" id="catch-up-tasks-hint"><%= t("Add between one and five tasks you completed on this day, or record that you completed none.") %></p>

        <ul class="catch-up-tasks-list" data-catch-up-tasks-list aria-labelledby="catch-up-tasks-hint"></ul>

        <p class="catch-up-tasks-error" data-catch-up-tasks-error role="alert" aria-live="assertive" hidden></p>

        <button class="ui-button ui-button--quiet catch-up-tasks-add" type="button" data-catch-up-tasks-add>
          <span class="catch-up-tasks-add-mark" aria-hidden="true">+</span><%= t("Add another task") %>
        </button>

        <button class="ui-button ui-button--quiet catch-up-tasks-none" type="button" data-catch-up-tasks-none><%= t("I did not complete any tasks") %></button>
      </div>

      <div class="catch-up-tasks-actions">
        <button class="ui-button ui-button--quiet" type="button" data-catch-up-tasks-close><%= t("Cancel") %></button>
        <button class="ui-button ui-button--primary" type="submit" data-catch-up-tasks-save><%= t("Save") %></button>
      </div>
    </form>
  </div>
</div>

<template data-catch-up-task-template>
  <li class="catch-up-task" data-catch-up-task>
    <div class="daily-goal-field catch-up-task-field">
      <label data-catch-up-task-label></label>
      <input class="daily-goal-input" type="text" name="task" maxlength="200" autocomplete="off" enterkeyhint="done" data-catch-up-task-input />
    </div>
    <button class="ui-button ui-button--quiet catch-up-task-remove" type="button" data-catch-up-task-remove><%= t("Remove") %></button>
  </li>
</template>
