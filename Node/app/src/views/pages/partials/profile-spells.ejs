<% if (profile.isOwner) { %>
  <section class="profile-spells" id="spells" data-explore aria-labelledby="profile-spells-title">
    <div class="dashboard-card explore-summary profile-spells-overview">
      <header class="dashboard-card-head profile-spells-head">
        <div>
          <h2 id="profile-spells-title"><%= t("Spells") %></h2>
          <p class="profile-note">
            <%= t("Bible reading earns Intelligence and increases mana. A reflection also earns Wisdom, which unlocks spells permanently without being spent.") %>
          </p>
        </div>
      </header>

      <dl class="explore-figures">
        <div class="explore-figure">
          <dt><%= t("Intelligence") %></dt>
          <dd data-explore-intelligence><%= profile.stats.intelligence %></dd>
        </div>
        <div class="explore-figure">
          <dt><%= t("Mana") %></dt>
          <dd data-explore-mana><%= profile.derived.maxMana %></dd>
        </div>
        <div class="explore-figure">
          <dt><%= t("Wisdom this month") %></dt>
          <dd data-explore-wisdom><%= profile.stats.wisdom %></dd>
        </div>
        <div class="explore-figure">
          <dt><%= t("Spells learned") %></dt>
          <dd><span data-explore-unlocked><%= profile.spells.unlockedCount %></span> <%= t("of {total}", { total: profile.spells.catalog.length }) %></dd>
        </div>
        <div class="explore-figure">
          <dt><%= t("Carried into battle") %></dt>
          <dd data-loadout-count><%= t("{count} of {limit} equipped", { count: (profile.spells.equipped || []).length, limit: profile.spells.limit || 3 }) %></dd>
        </div>
      </dl>

      <% if (profile.spells.unlockedCount > 0) { %>
        <p class="profile-note profile-loadout-note">
          <%= t("Equip up to {limit} learned spells for battle. The rest remain learned and can be swapped in at any time.", { limit: profile.spells.limit || 3 }) %>
        </p>
      <% } %>

      <p class="profile-note profile-spells-setup" data-explore-setup <%= profile.allocation.confirmed ? "hidden" : "" %>>
        <%= t("Confirm your base points above before learning a spell.") %>
      </p>
    </div>

    <div class="explore-path">
      <h3 class="explore-section-title"><%= t("Spell path") %></h3>

      <ol class="explore-list">
        <% profile.spells.catalog.forEach((spell, index) => { %>
          <li
            class="explore-item"
            data-spell="<%= spell.key %>"
            data-state="<%= spell.unlocked ? "unlocked" : (spell.available ? "available" : "locked") %>"
            <% if (spell.unlocked) { %>data-equipped="<%= spell.equipped ? "true" : "false" %>"<% } %>
          >
            <div class="explore-marker" aria-hidden="true"><%= index + 1 %></div>

            <details class="explore-card">
              <summary class="explore-summary-row">
                <span class="explore-summary-text">
                  <span class="explore-spell-name"><%= t(spell.name) %></span>
                  <span class="explore-spell-summary"><%= t(spell.summary) %></span>
                </span>
                <span class="explore-state" data-spell-state>
                  <% if (spell.unlocked && spell.equipped) { %>
                    <%= t("Carried into battle") %>
                  <% } else if (spell.unlocked) { %>
                    <%= t("Learned") %>
                  <% } else if (spell.available && profile.allocation.confirmed) { %>
                    <%= t("Ready to learn") %>
                  <% } else if (spell.available) { %>
                    <%= t("Confirm base points") %>
                  <% } else { %>
                    <%= t("Needs {count} more Wisdom", { count: spell.wisdomRemaining }) %>
                  <% } %>
                </span>
                <span class="explore-chevron" aria-hidden="true"></span>
              </summary>

              <div class="explore-card-body">
                <dl class="explore-spell-meta">
                  <div><dt><%= t("Mana cost") %></dt><dd><%= spell.manaCost %></dd></div>
                  <div><dt><%= t("Wisdom needed") %></dt><dd><%= spell.wisdomRequired %></dd></div>
                  <div><dt><%= t("Target") %></dt><dd><%= spell.target === "SELF" ? t("Yourself") : t("Opponent") %></dd></div>
                  <% if (spell.cooldownTurns) { %>
                    <div><dt><%= t("Cooldown") %></dt><dd><%= t("{count} turns", { count: spell.cooldownTurns }) %></dd></div>
                  <% } %>
                </dl>

                <p class="explore-spell-tactic"><%= t(spell.tactic) %></p>

                <div class="explore-actions">
                  <% if (spell.unlocked) { %>
                    <%
                    const loadoutFull = (profile.spells.equipped || []).length >= (profile.spells.limit || 3);
                    const blocked = !spell.equipped && loadoutFull;
                    %>
                    <button
                      class="explore-button explore-loadout-toggle"
                      type="button"
                      data-loadout-toggle="<%= spell.key %>"
                      aria-pressed="<%= spell.equipped ? "true" : "false" %>"
                      aria-describedby="loadout-note-<%= spell.key %>"
                      <%= blocked ? "disabled" : "" %>
                    ><%= spell.equipped ? t("Unequip") : t("Equip") %></button>
                    <p class="explore-note" id="loadout-note-<%= spell.key %>" data-spell-note>
                      <%= spell.equipped
                        ? t("This spell is carried into your next battle.")
                        : blocked
                          ? t("Unequip one first: you can carry three.")
                          : t("Learned. Equip it to carry it into your next battle.") %>
                    </p>
                  <% } else if (spell.available && profile.allocation.confirmed) { %>
                    <button class="explore-button explore-button-primary" type="button" data-spell-unlock="<%= spell.key %>">
                      <%= t("Learn {name}", { name: t(spell.name) }) %>
                    </button>
                  <% } else if (spell.available) { %>
                    <p class="explore-note" data-spell-note><%= t("Confirm your base points above first.") %></p>
                  <% } else { %>
                    <p class="explore-note" data-spell-note>
                      <%= t("Write a reflection with your Bible reading to earn more Wisdom.") %>
                    </p>
                  <% } %>
                </div>
              </div>
            </details>
          </li>
        <% }) %>
      </ol>

      <p class="explore-error" data-explore-error role="alert" hidden></p>
      <p class="visually-hidden" data-explore-status role="status" aria-live="polite"></p>
    </div>
  </section>
<% } %>
