<%
  const tasks = today.tasks;
  const reflection = today.reflection;
%>
<section class="profile-today" aria-labelledby="today-title">
  <h2 id="today-title" class="profile-section-title">Today</h2>

  <div class="dashboard-card profile-disclosure-group">
    <details class="profile-disclosure" data-today-tasks>
    <summary class="profile-disclosure-summary">
      <span class="profile-disclosure-label">Today's tasks</span>
      <span class="profile-disclosure-state">
        <% if (!tasks.shared) { %>
          Private
        <% } else if (!tasks.hasTasks) { %>
          No tasks added
        <% } else { %>
          <%= tasks.completedCount %> of <%= tasks.total %> done &middot; <%= tasks.completionPercent %>%
        <% } %>
      </span>
    </summary>

    <div class="profile-disclosure-body">
      <% if (!tasks.shared) { %>
        <p class="profile-private">
          This person keeps today's tasks private.
        </p>
      <% } else if (!tasks.hasTasks) { %>
        <p class="profile-empty">No tasks were added today.</p>
      <% } else { %>
        <ul class="profile-task-list">
          <% tasks.items.forEach((item) => { %>
            <li class="profile-task" data-completed="<%= item.completed ? "true" : "false" %>">
              <span class="profile-task-state"><%= item.completed ? "Done" : "Open" %></span>
              <span class="profile-task-text"><%= item.text %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </details>

  <details class="profile-disclosure" data-today-reflection>
    <summary class="profile-disclosure-summary">
      <span class="profile-disclosure-label">Today's Bible reflection</span>
      <span class="profile-disclosure-state">
        <% if (!reflection.shared) { %>
          Private
        <% } else if (!reflection.hasEntry) { %>
          No reading entry
        <% } else if (reflection.passages.length) { %>
          <%= reflection.passages.map((passage) => passage.reference).join(", ") %>
        <% } else { %>
          Answered <%= reflection.answer %>
        <% } %>
      </span>
    </summary>

    <div class="profile-disclosure-body">
      <% if (!reflection.shared) { %>
        <p class="profile-private">
          This person keeps today's Bible reflection private.
        </p>
      <% } else if (!reflection.hasEntry) { %>
        <p class="profile-empty">No reading entry for today yet.</p>
      <% } else { %>
        <% if (reflection.passages.length) { %>
          <ul class="profile-passage-list">
            <% reflection.passages.forEach((passage) => { %>
              <li class="profile-passage"><%= passage.reference %></li>
            <% }) %>
          </ul>
        <% } %>
        <% if (reflection.reflection) { %>
          <p class="profile-reflection"><%= reflection.reflection %></p>
        <% } else { %>
          <p class="profile-empty">No reflection was added.</p>
        <% } %>
      <% } %>
    </div>
  </details>
  </div>
</section>
