<%
  const tasks = today.tasks;
  const reflection = today.reflection;
  /* References are rebuilt from their parts so the book is named in the reader's language. */
  const reference = (passage) => (passage.bookName
    ? `${t(passage.bookName)} ${passage.chapter}:${passage.startVerse === passage.endVerse ? passage.startVerse : `${passage.startVerse}–${passage.endVerse}`}`
    : passage.reference);
%>
<section class="profile-today" aria-labelledby="today-title">
  <h2 id="today-title" class="profile-section-title"><%= t("Today") %></h2>

  <div class="dashboard-card profile-disclosure-group">
    <details class="profile-disclosure" data-today-tasks>
    <summary class="profile-disclosure-summary" data-show="<%= t("Show") %>" data-hide="<%= t("Hide") %>">
      <span class="profile-disclosure-label"><%= t("Today's tasks") %></span>
      <span class="profile-disclosure-state">
        <% if (!tasks.shared) { %>
          <%= t("Private") %>
        <% } else if (!tasks.hasTasks) { %>
          <%= t("No tasks added") %>
        <% } else { %>
          <%= t("{done} of {total} done · {percent}%", { done: tasks.completedCount, total: tasks.total, percent: tasks.completionPercent }) %>
        <% } %>
      </span>
    </summary>

    <div class="profile-disclosure-body">
      <% if (!tasks.shared) { %>
        <p class="profile-private">
          <%= t("This person keeps today's tasks private.") %>
        </p>
      <% } else if (!tasks.hasTasks) { %>
        <p class="profile-empty"><%= t("No tasks were added today.") %></p>
      <% } else { %>
        <ul class="profile-task-list">
          <% tasks.items.forEach((item) => { %>
            <li class="profile-task" data-completed="<%= item.completed ? "true" : "false" %>">
              <span class="profile-task-state"><%= item.completed ? t("Done") : t("Open") %></span>
              <span class="profile-task-text"><%= item.text %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </details>

  <details class="profile-disclosure" data-today-reflection>
    <summary class="profile-disclosure-summary" data-show="<%= t("Show") %>" data-hide="<%= t("Hide") %>">
      <span class="profile-disclosure-label"><%= t("Today's Bible reflection") %></span>
      <span class="profile-disclosure-state">
        <% if (!reflection.shared) { %>
          <%= t("Private") %>
        <% } else if (!reflection.hasEntry) { %>
          <%= t("No reading entry") %>
        <% } else if (reflection.passages.length) { %>
          <%= reflection.passages.map(reference).join(", ") %>
        <% } else { %>
          <%= t("Answered {answer}", { answer: t(reflection.answer) }) %>
        <% } %>
      </span>
    </summary>

    <div class="profile-disclosure-body">
      <% if (!reflection.shared) { %>
        <p class="profile-private">
          <%= t("This person keeps today's Bible reflection private.") %>
        </p>
      <% } else if (!reflection.hasEntry) { %>
        <p class="profile-empty"><%= t("No reading entry for today yet.") %></p>
      <% } else { %>
        <% if (reflection.passages.length) { %>
          <ul class="profile-passage-list">
            <% reflection.passages.forEach((passage) => { %>
              <li class="profile-passage"><%= reference(passage) %></li>
            <% }) %>
          </ul>
        <% } %>
        <% if (reflection.reflection) { %>
          <p class="profile-reflection"><%= reflection.reflection %></p>
        <% } else { %>
          <p class="profile-empty"><%= t("No reflection was added.") %></p>
        <% } %>
      <% } %>
    </div>
  </details>
  </div>
</section>
