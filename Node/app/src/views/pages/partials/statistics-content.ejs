<%
  const streakViews = [
    { slug: "strong", key: "recovery", label: "Strong", caption: "Strong streak leaderboard, ranked by current streak", empty: "No Strong streaks yet.", emptyHint: "Answer today's question to start the first streak." },
    { slug: "bible", key: "reading", label: "Bible", caption: "Bible reading streak leaderboard, ranked by current streak", empty: "No reading streaks yet.", emptyHint: "Answer the daily reading check to start the first streak." },
    { slug: "tasks", key: "goals", label: "Tasks", caption: "Tasks streak leaderboard, ranked by current streak", empty: "No completed-task streaks yet.", emptyHint: "Complete every task you plan for a day to start a streak." },
  ];
  const hasPrefetchedStatistics = typeof statisticsBySource !== "undefined" && Boolean(statisticsBySource);
  const availableStatistics = hasPrefetchedStatistics
    ? statisticsBySource
    : { [activeStreak.key]: statistics };
  const views = streakViews.map((view) => ({
    ...view,
    board: leaderboards[view.key],
    statistics: availableStatistics[view.key],
  }));
  const active = views.find((view) => view.slug === activeStreak.slug) || views[0];
  const renderedViews = hasPrefetchedStatistics ? views : [active];

  const dayWord = (value) => (value === 1 ? "day" : "days");
  const plural = (value, one, many) => `${value} ${value === 1 ? one : many}`;

  const escape = (value) => String(value)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");

  const counts = (split) => `${split.yes} Yes · ${split.no} No · ${split.total} total`;

  // One 100% composition track, used identically by both distribution panels and
  // by every weekday row, so the shares are directly comparable everywhere.
  const track = (split) => `
        <span class="ledger-track" data-empty="${split.total === 0}" aria-hidden="true">
          <span class="ledger-track-segment ledger-track-segment--yes" style="--bar-scale: ${split.yesSharePercentage / 100}"></span>
          <span class="ledger-track-segment ledger-track-segment--no" style="--bar-scale: ${split.noSharePercentage / 100}"><span class="ledger-track-hatch"></span></span>
          ${split.yes > 0 && split.no > 0
            ? `<span class="ledger-track-edge" style="--edge-at: ${split.yesSharePercentage}%"></span>`
            : ""}
        </span>`;

  const legend = () => `
      <ul class="ledger-legend">
        <li class="ledger-legend-item ledger-legend-item--yes">Yes</li>
        <li class="ledger-legend-item ledger-legend-item--no">No</li>
      </ul>`;

  const answerPanel = ({ hook, title, split, emptyCopy }) => `
        <div class="answer-panel" ${hook}>
          <h4 class="answer-panel-title">${escape(title)}</h4>
          ${split.total > 0
            ? `<p class="answer-panel-headline">
            <span class="answer-panel-percent">${escape(split.yesSharePercentage)}%</span>
            <span class="answer-panel-measure">Yes</span>
          </p>`
            : ""}
          ${track(split)}
          ${split.total > 0
            ? `<p class="answer-panel-values">${escape(counts(split))}</p>`
            : `<p class="answer-panel-empty">${escape(emptyCopy)}</p>`}
        </div>`;

  const shareSentence = (prefix, entry) => (entry.hasData
    ? `${prefix}: ${entry.label}, ${entry.percentage}% of ${plural(entry.total, "answer", "answers")}.`
    : "");
%>
<main id="main-content" tabindex="-1" class="dashboard-page statistics-page progress-page" data-recovery-leaderboard data-current-user-id="<%= leaderboards.recovery.currentUserId %>">
  <div class="page-shell">

    <header class="page-head">
      <div class="page-head-copy">
        <h1 class="page-head-title">Progress</h1>
        <p class="page-head-lede">Track your streaks and compare answer patterns across the community.</p>
      </div>

    </header>

    <section class="page-section progress-standing" aria-labelledby="streak-summary-title">
      <h2 class="sr-only" id="streak-summary-title">Current streaks</h2>
      <ul class="stat-line progress-summary">
        <% views.forEach((view) => { %>
          <li class="stat-line-item" data-streak-summary="<%= view.slug %>">
            <span class="stat-line-label"><%- include("../../components/ui/icon", { name: "flame", className: "ui-icon--sm" }) %><%= view.label %></span>
            <span class="stat-line-value"><%= view.board.overallBest?.value || 0 %> <%= dayWord(view.board.overallBest?.value || 0) %></span>
            <span class="stat-line-note">Best · <%= view.board.overallBest?.name || "No record yet" %></span>
          </li>
        <% }) %>
      </ul>
    </section>

    <section class="page-section section-frame section-frame--ruled" aria-labelledby="leaderboard-title">
      <div class="section-head">
        <h2 class="section-head-title" id="leaderboard-title"><%- include("../../components/ui/icon", { name: "trophy", className: "practice-mark" }) %>Streak leaderboard</h2>
        <span class="section-head-note" data-streak-board-count><%= plural(active.board.leaders.length, "user", "users") %></span>
      </div>
      <p class="section-lede">Compare current streaks across the community. Each one follows that member's time zone.</p>

      <nav class="segmented progress-segmented" aria-label="Choose a streak leaderboard">
        <% views.forEach((view) => { %>
          <% if (!hasPrefetchedStatistics && view.slug === active.slug) { %>
            <span class="segmented-option" aria-current="page"><%= view.label %></span>
          <% } else { %>
            <a
              class="segmented-option"
              href="/statistics?streak=<%= view.slug %>"
              data-progress-view="<%= view.slug %>"
              data-user-count="<%= view.board.leaders.length %>"
              <%- view.slug === active.slug ? 'aria-current="page"' : "" %>
            ><%= view.label %></a>
          <% } %>
        <% }) %>
      </nav>

      <% renderedViews.forEach((view) => { %>
        <article
          class="progress-board"
          data-streak-board="<%= view.key %>"
          data-streak-board-label="<%= view.label %> streak"
          data-progress-panel="<%= view.slug %>"
          <%- view.slug === active.slug ? "" : "hidden" %>
        >
        <div class="data-table-wrap">
          <table class="data-table data-table--stack">
            <caption class="sr-only"><%= view.caption %></caption>
            <thead>
              <tr>
                <th scope="col" class="data-table-rank">Rank</th>
                <th scope="col">Name</th>
                <th scope="col" class="data-table-figure">Streak</th>
              </tr>
            </thead>
            <tbody id="streak-board-<%= view.key %>-body" data-streak-board-body data-leaderboard-body>
              <% if (view.board.leaders.length) { %>
                <% view.board.leaders.forEach((entry, index) => { %>
                  <tr<%- entry.id === view.board.currentUserId ? ' data-current-user' : "" %><%- index >= 5 ? " hidden" : "" %>>
                    <td class="data-table-rank"><%= entry.rank %></td>
                    <td>
                      <a class="leaderboard-user user-link" href="/customer/<%= entry.id %>">
                        <span class="data-table-name"><%= entry.name %></span>
                      </a>
                      <% if (entry.id === view.board.currentUserId) { %>
                        <span class="data-table-you">You</span>
                      <% } %>
                    </td>
                    <td class="data-table-figure">
                      <%= entry.value %> <%= dayWord(entry.value) %>
                      <% if (entry.missedDays && entry.missedDays.count > 0) { %>

                        <span class="progress-missed"><%= entry.missedDays.count %> missed</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3">
                    <div class="empty-state press-region">
                      <p class="empty-state-title"><%= view.empty %></p>
                      <p class="empty-state-note"><%= view.emptyHint %></p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <button
          class="ui-button ui-button--secondary progress-more"
          type="button"
          data-streak-board-toggle
          aria-controls="streak-board-<%= view.key %>-body"
          aria-expanded="false"
          <%- view.board.leaders.length > 5 ? "" : "hidden" %>
        >View more</button>
        <p class="sr-only" data-streak-board-status role="status" aria-live="polite"></p>
        </article>
      <% }) %>
      <p class="sr-only" data-progress-view-status role="status" aria-live="polite"></p>
    </section>

    <% renderedViews.filter((view) => view.statistics).forEach((view) => {
      const dataScope = `${view.label} · all recorded answers`;
      const yours = view.statistics.yourAnswers;
      const community = view.statistics.communityAnswers;
      const weekdays = view.statistics.weekdayChart;
      const weekdaySummary = view.statistics.weekdaySummary;
      const prayerWorld = view.statistics.prayerWorld;
      const answersTitleId = view.slug === active.slug ? "answers-title" : `answers-title-${view.slug}`;
      const comparisonTitleId = view.slug === active.slug ? "answer-comparison-title" : `answer-comparison-title-${view.slug}`;
      const weekdayTitleId = view.slug === active.slug ? "weekday-chart-title" : `weekday-chart-title-${view.slug}`;
    %>
    <section
      class="page-section section-frame section-frame--ruled progress-answers"
      aria-labelledby="<%= answersTitleId %>"
      data-statistics-source="<%= view.key %>"
      data-progress-panel="<%= view.slug %>"
      <%- view.slug === active.slug ? "" : "hidden" %>
    >
      <div class="section-head">
        <h2 class="section-head-title" id="<%= answersTitleId %>">Answer patterns</h2>
        <span class="section-head-note"><%= dataScope %></span>
      </div>
      <p class="section-lede">Compare what you recorded with the community. A Yes and a No are both recorded answers, kept exactly as they were given.</p>

      <figure class="ledger-figure" data-answer-comparison aria-labelledby="<%= comparisonTitleId %>">
        <figcaption class="ledger-figure-head">
          <h3 class="ledger-figure-title t-component-title" id="<%= comparisonTitleId %>">Your answers and the community</h3>
          <p class="ledger-figure-note"><%= dataScope %></p>
        </figcaption>

        <%- legend() %>

        <div class="answer-compare">
          <%- answerPanel({
            hook: "data-personal-patterns",
            title: "Your answers",
            split: yours,
            emptyCopy: `No answers recorded yet. Your first ${view.label} answer fills this in.`,
          }) %>
          <%- answerPanel({
            hook: "data-community-patterns",
            title: "Community",
            split: community,
            emptyCopy: `No ${view.label} answers recorded yet across the community.`,
          }) %>
        </div>
      </figure>

      <figure class="ledger-figure" data-weekday-chart aria-labelledby="<%= weekdayTitleId %>">
        <figcaption class="ledger-figure-head">
          <h3 class="ledger-figure-title t-component-title" id="<%= weekdayTitleId %>">Community rhythm by weekday</h3>
          <p class="ledger-figure-note"><%= dataScope %></p>
        </figcaption>

        <% if (weekdaySummary.highest.hasData) { %>
          <p class="ledger-figure-insight"><%= shareSentence("Highest recorded Yes share", weekdaySummary.highest) %> <%= shareSentence("Lowest recorded Yes share", weekdaySummary.lowest) %></p>
        <% } else { %>
          <p class="ledger-figure-insight">No answers recorded yet. Each weekday fills in once members record <%= view.label %> answers on that day.</p>
        <% } %>

        <%- legend() %>

        <ul class="weekday-chart">
          <% weekdays.forEach((day, index) => { %>
            <li class="weekday-row" style="--reveal-index: <%= index %>">
              <span class="weekday-label">
                <span class="weekday-label-long"><%= day.longLabel %></span>
                <span class="weekday-label-short" aria-hidden="true"><%= day.label %></span>
              </span>
              <% if (day.total > 0) { %>
                <span class="weekday-share"><%= day.yesSharePercentage %>%<span class="sr-only"> Yes</span></span>
              <% } else { %>
                <span class="weekday-share weekday-share--empty"></span>
              <% } %>
              <%- track(day) %>
              <% if (day.total > 0) { %>
                <span class="weekday-values"><%= counts(day) %></span>
              <% } else { %>
                <span class="weekday-values weekday-values--empty">No answers</span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </figure>

      <div class="prayer-world" data-prayer-world>
        <div class="section-head">
          <h3 class="t-component-title">Community time zones</h3>
          <span class="section-head-note">Most active · <%= prayerWorld.activeRegion %></span>
        </div>
        <p class="section-lede">Grouped from the time zone each member selected. Achimari does not track anyone's location.</p>

        <div class="prayer-world-layout">
          <ul class="prayer-world-regions">
            <% prayerWorld.regions.forEach((region, index) => { %>
              <li class="prayer-world-region<%= region.isActive ? " is-active" : "" %>" style="--reveal-index: <%= index %>">
                <span class="prayer-world-region-name"><%= region.label %></span>
                <span class="prayer-world-region-track" aria-hidden="true">
                  <span class="prayer-world-region-fill" style="--bar-scale: <%= Math.max(0, Math.min(100, region.percentage)) / 100 %>"></span>
                </span>
                <span class="prayer-world-region-count"><%= region.count %></span>
                <span class="prayer-world-region-share"><%= region.percentage %>%</span>
              </li>
            <% }) %>
            <% if (!prayerWorld.regions.length) { %>
              <li class="prayer-world-region prayer-world-region--empty">
                <span class="prayer-world-region-name">No time zones recorded yet</span>
              </li>
            <% } %>
          </ul>

          <div class="prayer-world-visual" aria-hidden="true">
            <div class="prayer-globe">
              <span class="prayer-globe-shine"></span>
              <span class="prayer-globe-land prayer-globe-land-americas"></span>
              <span class="prayer-globe-land prayer-globe-land-europe"></span>
              <span class="prayer-globe-land prayer-globe-land-africa"></span>
              <span class="prayer-globe-land prayer-globe-land-asia"></span>
              <span class="prayer-globe-land prayer-globe-land-oceania"></span>
              <% prayerWorld.regions.filter((region) => region.count > 0).forEach((region, index) => { %>
                <span
                  class="prayer-globe-point<%= region.isActive ? " is-active" : "" %>"
                  style="left: <%= region.x %>%; top: <%= region.y %>%; --point-scale: <%= region.pointScale %>; --reveal-index: <%= index %>"
                ></span>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>
    <% }) %>

  </div>

  <%- include("../../components/layout/footer") %>
</main>
