<%
  const passwordProblems = typeof passwordErrors === "undefined" || !passwordErrors ? [] : passwordErrors;
  const passwordConfirmed = typeof passwordSuccess === "undefined" ? "" : passwordSuccess;
  const nicknameProblems = typeof nicknameErrors === "undefined" || !nicknameErrors ? [] : nicknameErrors;
  const nicknameConfirmed = typeof nicknameSuccess === "undefined" ? "" : nicknameSuccess;

  /*
    The password form is three fields a reader touches rarely, sitting between
    the page's introduction and the answer correction they came for. On a phone
    it folds; everywhere else it is the page as it was. It is never folded while
    it is carrying a validation error — an error inside a closed disclosure is
    an error nobody reads.
  */
  const foldPassword = passwordProblems.length === 0;
%>
<main id="main-content" tabindex="-1" class="dashboard-page settings-page" data-settings-toast="<%= toastMessage || "" %>" data-settings-toast-variant="<%= toastVariant || "default" %>">
  <div class="page-shell">

    <header class="page-head">
      <h1 class="page-head-title"><%= t("Settings") %></h1>
      <p class="page-head-lede"><%= t("Manage your account and correct today's recorded answers.") %></p>
      <p class="settings-jump">
        <a class="settings-jump-link" href="#settings-answers"><%= t("Go to Today's answers") %></a>
      </p>
    </header>

    <section class="settings-group press-region" aria-labelledby="settings-account-title">
      <header class="settings-group-heading">
        <h2 class="settings-group-title" id="settings-account-title"><%- include("../../components/ui/icon", { name: "user", className: "practice-mark" }) %><%= t("Account") %></h2>
      </header>

      <% if (nicknameProblems.length) { %>
        <p class="settings-feedback settings-feedback--error" role="alert"><%- include("../../components/ui/icon", { name: "warning-circle", className: "ui-icon--sm field-error-mark" }) %><%= nicknameProblems.join(" ") %></p>
      <% } else if (nicknameConfirmed) { %>
        <p class="settings-feedback settings-feedback--success" role="status"><%= nicknameConfirmed %></p>
      <% } %>

      <form class="settings-form settings-form--account" action="/settings/nickname" method="post">
        <div class="settings-row">
          <span class="settings-row-label">
            <label class="field-label" for="settings-nickname"><%= t("Nickname") %></label>
            <span class="field-hint"><%= t("The name other members see on leaderboards and prayers.") %></span>
          </span>
          <span class="settings-row-control">
            <input
              class="field-input settings-input"
              id="settings-nickname"
              type="text"
              name="name"
              autocomplete="name"
              spellcheck="false"
              value="<%= values.name || auth.name %>"
              required
            />
          </span>
        </div>
        <div class="settings-row settings-row--actions">
          <button class="ui-button ui-button--primary ui-button--large" type="submit"><%= t("Save nickname") %></button>
        </div>
      </form>
    </section>

    <section class="settings-group press-region" aria-labelledby="settings-display-title">
      <header class="settings-group-heading">
        <h2 class="settings-group-title" id="settings-display-title"><%= t("Language and theme") %></h2>
        <p class="settings-group-note"><%= t("Saved in this browser, whether you are signed in or not.") %></p>
      </header>
      <%- include("../../components/ui/preferences", { tone: "paper" }) %>
    </section>

    <section class="settings-group press-region" aria-labelledby="settings-password-title">
      <header class="settings-group-heading">
        <h2 class="settings-group-title" id="settings-password-title"><%- include("../../components/ui/icon", { name: "key", className: "practice-mark" }) %><%= t("Password") %></h2>
        <p class="settings-group-note"><%= t("Changing your password does not sign out your other sessions.") %></p>
      </header>

      <% if (passwordProblems.length) { %>
        <p class="settings-feedback settings-feedback--error" role="alert"><%- include("../../components/ui/icon", { name: "warning-circle", className: "ui-icon--sm field-error-mark" }) %><%= passwordProblems.join(" ") %></p>
      <% } else if (passwordConfirmed) { %>
        <p class="settings-feedback settings-feedback--success" role="status"><%= passwordConfirmed %></p>
      <% } %>

      <details class="settings-disclosure" data-settings-password<%- foldPassword ? " data-phone-fold" : "" %> open>
        <summary class="fold-summary" aria-controls="settings-password-form">
          <span class="fold-summary-label"><%= t("Change password") %></span>
        </summary>

      <form class="settings-form settings-form--password fold-body" id="settings-password-form" action="/settings/password" method="post">
        <div class="settings-row">
          <span class="settings-row-label">
            <label class="field-label" for="settings-current-password"><%= t("Current password") %></label>
          </span>
          <span class="settings-row-control">
            <input class="field-input settings-input" id="settings-current-password" type="password" name="currentPassword" autocomplete="current-password" required />
          </span>
        </div>
        <div class="settings-row">
          <span class="settings-row-label">
            <label class="field-label" for="settings-new-password"><%= t("New password") %></label>
            <span class="field-hint"><%= t("At least 8 characters.") %></span>
          </span>
          <span class="settings-row-control">
            <input class="field-input settings-input" id="settings-new-password" type="password" name="password" autocomplete="new-password" minlength="8" required />
          </span>
        </div>
        <div class="settings-row">
          <span class="settings-row-label">
            <label class="field-label" for="settings-confirm-password"><%= t("Confirm new password") %></label>
          </span>
          <span class="settings-row-control">
            <input class="field-input settings-input" id="settings-confirm-password" type="password" name="passwordConfirmation" autocomplete="new-password" minlength="8" required />
          </span>
        </div>
        <div class="settings-row settings-row--actions">
          <button class="ui-button ui-button--primary ui-button--large" type="submit"><%= t("Change password") %></button>
        </div>
      </form>
      </details>
    </section>

    <section class="settings-group press-region" id="settings-answers" aria-labelledby="settings-today-title">
      <header class="settings-group-heading">
        <h2 class="settings-group-title" id="settings-today-title"><%= t("Today's answers") %></h2>
        <p class="settings-group-note"><%= t("Use this section to correct an answer.") %> <%= t("Record new answers on") %> <a class="link" href="/daily-check-in"><%= t("Today") %></a>.</p>
      </header>

      <div class="surface-panel settings-answers">
        <div class="settings-row" data-settings-answer>
          <span class="settings-row-label">
            <span class="field-label"><%= t("Strong") %></span>
            <span class="field-hint" data-settings-answer-current><%= t("Loading…") %></span>
          </span>
          <span class="settings-row-control settings-answer-actions" role="group" aria-label="<%= t("Change today's answer") %>">
            <button class="settings-answer-button settings-answer-yes" type="button" data-settings-answer-option="YES" aria-pressed="false"><%= t("YES") %></button>
            <button class="settings-answer-button settings-answer-no" type="button" data-settings-answer-option="NO" aria-pressed="false"><%= t("NO") %></button>
          </span>
        </div>

        <div class="settings-row settings-row--stacked" data-settings-reading>
          <span class="settings-row-label">
            <span class="field-label"><%= t("Bible reading") %></span>
            <span class="field-hint" data-settings-reading-current><%= t("Loading…") %></span>
          </span>
          <span class="settings-row-control settings-answer-actions" role="group" aria-label="<%= t("Change today's Bible reading answer") %>">
            <button class="settings-answer-button settings-answer-yes" type="button" data-settings-reading-answer-option="YES" aria-pressed="false"><%= t("YES") %></button>
            <button class="settings-answer-button settings-answer-no" type="button" data-settings-reading-answer-option="NO" aria-pressed="false"><%= t("NO") %></button>
          </span>

          <div class="settings-reading-details" data-settings-reading-details hidden>
            <p class="field-label"><%= t("Today's passages") %></p>
            <ul class="settings-reading-refs" data-settings-reading-refs></ul>
            <button class="ui-button ui-button--quiet settings-reading-edit" type="button" data-settings-reading-edit><%= t("Edit passages and reflection") %></button>
          </div>
        </div>
      </div>
    </section>

  </div>

  <%- include("./reading-modal") %>

  <%- include("../../components/layout/footer") %>
</main>
