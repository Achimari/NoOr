<main id="main-content" tabindex="-1" class="dashboard-page prayer-page" data-prayer-page>
  <div class="page-shell">

    <header class="page-head prayers-opening">
      <div class="page-head-copy">
        <h1 class="page-head-title">My prayers</h1>
        <p class="page-head-lede">Review the requests you have shared and mark them answered when the time comes.</p>
      </div>

    </header>

    <section class="page-section section-frame section-frame--ruled" aria-labelledby="prayer-composer-title">
      <h2 class="section-head-title" id="prayer-composer-title">Share a prayer request</h2>
      <p class="section-lede">Your request will be visible to everyone in the community. Share only what you are comfortable making public.</p>

      <%#
        The composer folds on a phone so the requests already shared are not
        pushed a screen and a half down by an empty box. The sharing
        explanation above stays outside the fold, so it is read before the
        Share control is ever reached, and the form itself is rendered open —
        with no script the composer is simply there, as it always was.
      -%>
      <details class="prayer-composer-disclosure" data-prayer-composer-disclosure data-phone-fold open>
        <summary class="fold-summary" aria-controls="prayer-composer-form">
          <span class="fold-summary-label">Write a request</span>
        </summary>

      <form class="prayer-composer fold-body" id="prayer-composer-form" data-prayer-form novalidate>
        <div class="field">
          <label class="field-label" for="prayer-composer-input">Prayer request</label>
          <textarea
            class="field-textarea field-textarea--writing"
            id="prayer-composer-input"
            name="prayer"
            rows="6"
            maxlength="500"
            required
          ></textarea>
          <span class="field-hint"><%- include("../../components/ui/icon", { name: "globe", className: "ui-icon--sm" }) %>Up to 500 characters. Visible to everyone in the community.</span>
        </div>

        <div class="ui-button-group prayer-composer-actions">
          <button class="ui-button ui-button--primary" type="submit"><%- include("../../components/ui/icon", { name: "send", className: "ui-icon--sm" }) %>Share request</button>
          <p class="prayer-form-status" data-prayer-status role="status" aria-live="polite"></p>
        </div>
      </form>
      </details>
    </section>

    <section class="page-section section-frame section-frame--ruled" aria-labelledby="prayer-active-title">
      <div class="section-head">
        <h2 class="section-head-title" id="prayer-active-title">Active requests</h2>
        <span class="section-head-note" data-active-prayer-count><%= prayerLists.active.length %> items</span>
      </div>

      <%- include("./prayers-table", { prayers: prayerLists.active, showActions: showPrayerActions,
        listType: "active" }) %>
    </section>

  </div>

  <%- include("../../components/layout/footer") %>
</main>
