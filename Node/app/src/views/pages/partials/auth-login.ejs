<%
  const formErrors = typeof errors === "undefined" ? [] : errors;
  const byField = typeof fieldErrors === "undefined" || !fieldErrors ? {} : fieldErrors;
  const submitted = typeof values === "undefined" || !values ? {} : values;
  const attributed = new Set(Object.values(byField).flat());
  const generalErrors = formErrors.filter((message) => !attributed.has(message));
%>
<main id="main-content" tabindex="-1" class="auth-page">
  <section class="auth-gateway">

    <header class="auth-masthead">
      <%- include("../../components/ui/brand-mark", { tone: "paper", size: "masthead" }) %>
    </header>

    <div class="auth-body">

      <div class="auth-form-column">
        <form class="auth-card press-region" action="/login" method="post" novalidate>
        <header class="auth-head">
          <h1 class="auth-title"><%= t("auth.login.title") %></h1>
          <% if (t("auth.login.subtitle")) { %>
            <p class="auth-subtitle"><%= t("auth.login.subtitle") %></p>
          <% } %>
        </header>

        <% if (generalErrors.length) { %>
          <div class="auth-errors" role="alert">
            <%- include("../../components/ui/icon", { name: "warning", className: "ui-icon--sm" }) %>
            <% generalErrors.forEach((error) => { %>
              <p><%= error %></p>
            <% }) %>
          </div>
        <% } %>

        <div class="field auth-field">
          <label class="field-label" for="login-name"><%= t("auth.login.loginLabel") %></label>
          <input
            class="field-input"
            id="login-name"
            type="text"
            name="login"
            autocomplete="username"
            spellcheck="false"
            autocapitalize="none"
            value="<%= submitted.login || "" %>"
            <% if ((byField.name || byField.login || []).length) { %>aria-invalid="true" aria-describedby="login-name-error"<% } %>
            required
          />
          <% if ((byField.name || byField.login || []).length) { %>
            <p class="field-error" id="login-name-error"><%- include("../../components/ui/icon", { name: "warning-circle", className: "ui-icon--sm field-error-mark" }) %><%= (byField.name || byField.login).join(" ") %></p>
          <% } %>
        </div>

        <div class="field auth-field">
          <label class="field-label" for="login-password"><%= t("auth.login.passwordLabel") %></label>
          <input
            class="field-input"
            id="login-password"
            type="password"
            name="password"
            autocomplete="current-password"
            <% if ((byField.password || []).length) { %>aria-invalid="true" aria-describedby="login-password-error"<% } %>
            required
          />
          <% if ((byField.password || []).length) { %>
            <p class="field-error" id="login-password-error"><%- include("../../components/ui/icon", { name: "warning-circle", className: "ui-icon--sm field-error-mark" }) %><%= byField.password.join(" ") %></p>
          <% } %>
        </div>

        <div class="auth-actions">
          <button class="ui-button ui-button--accent auth-submit" type="submit"><%= t("auth.login.submit") %><%- include("../../components/ui/icon", { name: "arrow-right", className: "ui-icon--sm" }) %></button>
          <a class="ui-button ui-button--quiet auth-secondary" href="/onboarding"><%= t("auth.login.onboardingLink") %></a>
        </div>
        </form>
      </div>

    </div>
  </section>
</main>
