<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/brand/achimari-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/achimari-mark-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/achimari-touch-icon.png" />
    <link rel="mask-icon" href="/brand/achimari-symbol.svg" color="#000000" />
    <link rel="manifest" href="/brand/site.webmanifest" />
    <link rel="preload" href="/fonts/ibm-plex-sans-condensed/IBMPlexSansCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded/Unbounded-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title><%= title || "" %></title>
    <%- include("./loading-head") %>

    <% const pageAssets = getPageAssets(pageId); %>
    <% const authStyles = [...(assets.styles || []), ...(pageAssets.styles || [])]; %>
    <% authStyles.forEach((href) => { %>
      <link rel="stylesheet" href="<%= href %>" onload="window.NoOrTrackStylesheet()" onerror="window.NoOrTrackStylesheet()" />
    <% }) %>
    <script>window.NoOrSealStylesheets(<%= authStyles.length %>)</script>
  </head>
  <body data-page="<%= pageId %>">

    <div class="noor-loader" data-noor-loader aria-hidden="true">
      <div class="noor-loader-mark" aria-hidden="true"></div>
      <p class="sr-only" role="status" aria-live="polite" data-noor-loader-status></p>
    </div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <%- body %>
  </body>
</html>
