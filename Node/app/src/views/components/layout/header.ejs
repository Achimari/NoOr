<%
  const navLinks = t("header.nav", []);
  const current = (to) => (currentPath === to ? ' aria-current="page"' : "");
%>
<header class="header">
  <div class="header-container">
    <div class="header-left">
      <a href="/daily-check-in" class="logo-block logo-link">
        <%- include("../ui/brand-mark", { tone: "chrome" }) %>
      </a>
    </div>

    <% if (navLinks.length) { %>
      <nav class="header-nav" aria-label="Primary">
        <% navLinks.forEach((link)=> { %>
          <a href="<%= link.to %>" class="header-link<%= currentPath === link.to ? " active" : "" %>"<%- current(link.to) %>>
            <%= link.label %>
          </a>
          <% }) %>
      </nav>
      <% } %>

    <div class="header-actions">
      <% if (!auth) { %>
        <nav class="header-auth-actions" aria-label="Account">
          <a class="header-auth-link" href="/login">Login</a>
        </nav>
      <% } %>
      <% if (auth) { %>
        <a
          class="header-help-link"
          href="/help"
          aria-label="Help"
          title="Help"
          <%- currentPath === "/help" ? 'aria-current="page"' : "" %>
        >
          <%- include("../ui/icon", { name: "warning-circle" }) %>
        </a>
        <div class="header-account" data-account-menu>
          <button
            class="header-account-button"
            type="button"
            data-account-toggle
            aria-expanded="false"
            aria-controls="account-panel"
            aria-label="<%= auth.name %> account menu"
          >
            <span
              class="header-account-identity"
              data-emblem="<%= auth.emblemKey %>"
              data-accent="<%= auth.accentKey %>"
              aria-hidden="true"
            ></span>
          </button>

          <div class="header-account-panel" id="account-panel" data-account-panel hidden>
            <nav class="header-account-nav" aria-label="Account">
              <a class="header-account-link<%= currentPath === "/profile" ? " active" : "" %>" href="/profile" data-account-item>My Profile</a>
              <a class="header-account-link<%= currentPath === "/achievements" ? " active" : "" %>" href="/achievements" data-account-item>Achievements</a>
            </nav>

            <section class="header-account-section" aria-labelledby="account-region-label">

              <p class="header-account-heading" id="account-region-label">Region / Time zone</p>
              <div class="header-timezone" data-timezone-menu>
                <button class="header-timezone-button" type="button" data-timezone-toggle aria-expanded="false" aria-label="Change timezone">
                  <span data-timezone-current><%= getTimezoneLabel(auth.timezone) %></span>
                </button>
                <div class="header-timezone-menu" data-timezone-options hidden>
                  <input class="header-timezone-search" type="search" placeholder="Search time zones…" data-timezone-search autocomplete="off" spellcheck="false" aria-label="Search time zones" />
                  <div class="header-timezone-list" data-timezone-list>
                    <% timezoneOptions.forEach((timezone) => { %>
                      <button class="header-timezone-option"<%- timezone.value === auth.timezone ? ' aria-current="true"' : "" %> type="button" data-timezone-option="<%= timezone.value %>" data-timezone-label="<%= timezone.label.toLowerCase() %>" data-timezone-value="<%= timezone.value.toLowerCase() %>">
                        <%= timezone.label %>
                      </button>
                    <% }) %>
                  </div>
                  <span class="header-timezone-empty" data-timezone-empty hidden>No timezones found</span>
                </div>
              </div>
            </section>

            <nav class="header-account-nav" aria-label="Account settings">
              <a class="header-account-link<%= currentPath === "/settings" ? " active" : "" %>" href="/settings" data-account-item>Settings</a>
            </nav>

            <form class="header-account-logout" action="/logout" method="post">
              <button class="header-account-link header-account-logout-button" type="submit" data-account-item>Logout</button>
            </form>
          </div>
        </div>
      <% } %>
      <%#
        The phone range's navigation: a native disclosure that opens a panel
        directly under the masthead. Real links, no role="menu"; the browser
        reports the expanded state itself, so there is no aria-expanded here to
        go stale when script is off. account-menu.js only adds dismissal and the
        nested time-zone list. Hidden above 959px, where .header-nav and the
        account control carry the same destinations.
      -%>
      <% if (navLinks.length) { %>
        <details class="site-menu" data-site-menu>
          <summary class="site-menu-toggle">
            <span class="sr-only">Menu</span>
            <span class="site-menu-line" aria-hidden="true"></span>
            <span class="site-menu-line" aria-hidden="true"></span>
          </summary>
          <nav class="site-menu-panel" aria-label="Primary">
            <ul class="site-menu-list site-menu-list--primary">
              <% navLinks.forEach((link) => { %>
                <li><a class="site-menu-link" href="<%= link.to %>"<%- current(link.to) %>><%= link.label %></a></li>
              <% }) %>
            </ul>

            <% if (auth) { %>
              <div class="site-menu-group">
                <p class="site-menu-mark">Account</p>
                <ul class="site-menu-list">
                  <li><a class="site-menu-link" href="/profile"<%- current("/profile") %>>My Profile</a></li>
                  <li><a class="site-menu-link" href="/achievements"<%- current("/achievements") %>>Achievements</a></li>
                  <li><a class="site-menu-link" href="/settings"<%- current("/settings") %>>Settings</a></li>
                </ul>

                <button
                  class="site-menu-link site-menu-timezone"
                  type="button"
                  data-mobile-timezone-toggle
                  aria-expanded="false"
                  aria-controls="site-menu-timezone-panel"
                >
                  Region / Time zone
                  <span class="site-menu-timezone-current" data-timezone-current><%= getTimezoneLabel(auth.timezone) %></span>
                </button>
                <div class="site-menu-timezone-panel" id="site-menu-timezone-panel" data-mobile-timezone-panel hidden>
                  <input
                    class="header-timezone-search"
                    type="search"
                    placeholder="Search time zones…"
                    data-mobile-timezone-search
                    autocomplete="off"
                    spellcheck="false"
                    aria-label="Search time zones"
                  />
                  <div class="header-timezone-list" data-mobile-timezone-list>
                    <% timezoneOptions.forEach((timezone) => { %>
                      <button class="header-timezone-option"<%- timezone.value === auth.timezone ? ' aria-current="true"' : "" %> type="button" data-timezone-option="<%= timezone.value %>" data-timezone-label="<%= timezone.label.toLowerCase() %>" data-timezone-value="<%= timezone.value.toLowerCase() %>">
                        <%= timezone.label %>
                      </button>
                    <% }) %>
                  </div>
                  <span class="header-timezone-empty" data-mobile-timezone-empty hidden>No timezones found</span>
                </div>
              </div>

              <form class="site-menu-group site-menu-logout" action="/logout" method="post">
                <button class="site-menu-link" type="submit">Logout</button>
              </form>
            <% } %>
          </nav>
        </details>
      <% } %>
    </div>
  </div>
</header>
