
<% if (kind === "guardian") { %>
  <svg class="battle-silhouette" data-silhouette="guardian" viewBox="0 0 200 320" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="halo-<%= uid %>" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fffaef" stop-opacity="0.98" />
        <stop offset="42%" stop-color="#eedcb4" stop-opacity="0.52" />
        <stop offset="100%" stop-color="#e6d2a6" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="cloth-<%= uid %>" x1="0.1" y1="0" x2="0.85" y2="1">
        <stop offset="0%" stop-color="#fffdf6" />
        <stop offset="55%" stop-color="#efe6d2" />
        <stop offset="100%" stop-color="#d5c8ae" />
      </linearGradient>
    </defs>

    <g class="bfig-halo">
      <circle cx="100" cy="60" r="50" fill="url(#halo-<%= uid %>)" />
      <circle cx="100" cy="60" r="30" fill="none" stroke="#e9d4a4" stroke-opacity="0.8" stroke-width="1.1" />
    </g>

    <g class="bfig-body">

      <path class="bfig-cape" fill="#e9dfc9" stroke="#c2b498" stroke-width="0.9" opacity="0.9"
        d="M96 96 C74 108 60 150 48 214 C42 248 34 276 22 300 Q19 305 26 304 C54 296 74 268 84 226 C92 190 96 140 100 108 Z" />

      <path class="bfig-robe" fill="url(#cloth-<%= uid %>)" stroke="#c2b498" stroke-width="1"
        d="M100 80 C117 82 126 99 129 127 C134 171 142 228 154 297 Q155 304 147 304 L53 304 Q45 304 46 297 C58 228 66 172 71 128 C74 99 83 82 100 80 Z" />
      <path class="bfig-facet-light" fill="#fffdf7" opacity="0.62"
        d="M100 82 L71 128 L64 232 L82 304 L100 304 Z" />
      <path class="bfig-facet-shade" fill="#c9bda3" opacity="0.38"
        d="M100 82 L129 127 L137 240 L126 304 L100 304 Z" />
      <g class="bfig-folds" fill="none" stroke="#b8ab92" stroke-opacity="0.5" stroke-width="0.9">
        <path d="M100 96 L100 302" />
        <path d="M86 130 L74 302" />
        <path d="M116 134 L130 302" />
        <path d="M62 236 Q100 228 139 238" />
      </g>

      <g class="bfig-emblem" stroke="#c2a15c" stroke-width="1.3" fill="none">
        <rect x="90" y="164" width="20" height="24" rx="3.5" />
        <path d="M100 158 L100 164 M93 188 L107 188" />
        <circle class="bfig-emblem-light" cx="100" cy="176" r="4.4" fill="#e6c07a" stroke="none" />
      </g>

      <path class="bfig-hood" fill="#fbf7ec" stroke="#c2b498" stroke-width="1"
        d="M100 34 C118 34 128 48 129 66 C130 84 121 96 108 100 C94 104 84 96 80 82 C76 62 84 36 100 34 Z" />
      <path class="bfig-face" fill="#cdbfa4" opacity="0.5"
        d="M104 50 C117 52 122 64 120 78 C118 90 110 96 102 95 C95 93 91 82 93 68 C95 56 99 50 104 50 Z" />
    </g>

    <g class="bfig-shards" fill="#e0d5be" stroke="none">
      <path d="M152 122 l12 -6 -3 12 z" />
      <path d="M36 164 l-12 -4 6 12 z" />
      <path d="M158 234 l13 4 -10 8 z" />
      <path d="M34 246 l-12 7 2 -13 z" />
    </g>
  </svg>
<% } else { %>
  <svg class="battle-silhouette" data-silhouette="wraith" viewBox="0 0 200 320" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="smoke-<%= uid %>" x1="0.3" y1="0" x2="0.72" y2="1">
        <stop offset="0%" stop-color="#4f4f4f" />
        <stop offset="42%" stop-color="#2c2c2c" />
        <stop offset="100%" stop-color="#131313" />
      </linearGradient>
      <radialGradient id="smoke-soft-<%= uid %>" cx="50%" cy="40%" r="58%">
        <stop offset="0%" stop-color="#6d6d6d" stop-opacity="0.38" />
        <stop offset="100%" stop-color="#6d6d6d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="cowl-<%= uid %>" cx="50%" cy="45%" r="55%">
        <stop offset="0%" stop-color="#0a0a0a" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#0a0a0a" stop-opacity="0" />
      </radialGradient>
    </defs>

    <g class="bfig-aura">
      <ellipse cx="100" cy="160" rx="66" ry="92" fill="url(#smoke-soft-<%= uid %>)" />
      <ellipse cx="100" cy="300" rx="52" ry="11" fill="#1c1c1c" opacity="0.16" />
    </g>

    <g class="bfig-body">

      <path class="bfig-plume" fill="url(#smoke-<%= uid %>)"
        d="M100 40
           C121 41 134 56 138 80
           C154 94 162 122 158 150
           C154 182 148 214 142 244
           C140 262 137 278 135 292
           L126 268 L120 300 L112 270 L105 302 L98 272 L90 300 L83 268 L76 298 L70 270 L65 292
           C63 278 60 262 58 244
           C52 214 46 182 42 150
           C38 122 46 94 62 80
           C66 56 79 41 100 40 Z" />

      <path class="bfig-mantle" fill="#575757" opacity="0.5"
        d="M100 52 C119 53 130 66 134 86 C146 100 150 122 146 142 C130 128 116 122 100 122 C84 122 70 128 54 142 C50 122 54 100 66 86 C70 66 81 53 100 52 Z" />

      <ellipse class="bfig-cowl" cx="100" cy="106" rx="30" ry="26" fill="url(#cowl-<%= uid %>)" />

      <path class="bfig-curl" fill="none" stroke="#3f3f3f" stroke-width="4.4" stroke-linecap="round"
        d="M100 42 Q87 24 99 13 Q112 4 119 16 Q123 25 115 29" />

      <g class="bfig-tendrils" fill="none" stroke="#3b3b3b" stroke-linecap="round" opacity="0.55">
        <path d="M64 74 Q50 62 46 44" stroke-width="2.6" />
        <path d="M137 78 Q152 68 158 52" stroke-width="2.2" />
        <path d="M46 146 Q24 152 14 140" stroke-width="2.8" />
        <path d="M154 156 Q178 164 186 150" stroke-width="2.4" />
        <path d="M52 196 Q30 206 24 224" stroke-width="2.2" />
      </g>

      <g class="bfig-eyes">
        <ellipse cx="88" cy="106" rx="6.6" ry="4.4" fill="#fbfbfb" />
        <ellipse cx="113" cy="104" rx="6.6" ry="4.4" fill="#fbfbfb" />
      </g>
    </g>

    <g class="bfig-shards" fill="#3f3f3f" stroke="none">
      <path d="M160 96 l13 -6 -4 13 z" />
      <path d="M38 134 l-14 -4 8 12 z" />
      <path d="M164 208 l14 4 -11 9 z" />
      <path d="M34 222 l-14 8 3 -14 z" />
    </g>
  </svg>
<% } %>
