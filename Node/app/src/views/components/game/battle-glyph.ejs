<% } else if (name === "damage") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5 13.8 9l6.7-1.8-4.8 4.8 4.8 4.8-6.7-1.8-1.8 6.5-1.8-6.5-6.7 1.8L8.3 12 3.5 7.2 10.2 9Z"/></svg>
