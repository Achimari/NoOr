<% } else if (name === "cloud") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6.5 18h10a4 4 0 0 0 .4-8 5.5 5.5 0 0 0-10.5 1.3A3.4 3.4 0 0 0 6.5 18Z"/><path d="M9 21h7"/></svg>
<% } else if (name === "shield") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3 19 5.6v5.6c0 4.1-2.9 7.7-7 9.2-4.1-1.5-7-5.1-7-9.2V5.6Z"/><path d="m9 12 2 2 4-4"/></svg>
<% } else if (name === "burn") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8.5 14.5A3.5 3.5 0 0 0 12 21a6 6 0 0 0 6-6c0-4-3-6.5-4.5-9.5-.5 2.5-2 4-4 5.5-.8.6-1 1.8-.5 3.5Z"/></svg>
<% } else if (name === "slow") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
<% } else { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"/></svg>
<% } %>
