<%

const glyphClass = ["battle-glyph", typeof className === "undefined" ? "" : className].filter(Boolean).join(" ");
%>
<% if (name === "strength") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 13.5 5 11l2-2 2.5 2.5L15 6l3 3-5.5 5.5 2.5 2.5-2 2-2.5-2.5Z"/><path d="m15 6 1.5-1.5 3 3L18 9"/></svg>
<% } else if (name === "dexterity") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17 17 5M10 5h7v7"/><path d="M5 11v6h6"/></svg>
<% } else if (name === "intelligence") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="5" r="2"/><circle cx="6" cy="16" r="2"/><circle cx="18" cy="16" r="2"/><path d="m10.8 6.7-3.6 7.5M13.2 6.7l3.6 7.5M8 16h8"/></svg>
<% } else if (name === "wisdom") { %>
