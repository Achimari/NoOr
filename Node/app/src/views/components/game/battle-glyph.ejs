<% } else if (name === "attack") { %>
  <svg class="<%= glyphClass %>" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5 13.9 9 21.5 12 13.9 15 12 22.5 10.1 15 2.5 12 10.1 9Z"/></svg>
<% } else if (name === "guard") { %>
