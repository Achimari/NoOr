<%#
  One closed icon, from the vendored Phosphor registry.

    name       required, must exist in icon-registry.json (an unknown name throws)
    className  optional extra classes
    label      optional accessible name — pass it ONLY when this icon is the only
               thing naming its control. With no label the icon is decorative and
               is hidden from assistive technology, which is right whenever a
               visible text label sits beside it.
-%>
<%- renderIcon(name, {
      className: typeof className === "undefined" ? "" : className,
      label: typeof label === "undefined" ? "" : label,
    }) %>
